# Copier vers .env.local et remplir avant de lancer `npm run dev`
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
JWT_SECRET=generate-with-openssl-rand-base64-48

# Compagnon de test — webhook n8n (Chat Trigger, mode webhook) de
# l'orchestrateur "Pulse · Compagnon de test — Orchestrateur", protégé par
# Basic Auth (identifiant "Compagnon Webhook Auth" dans n8n). Sans ces
# variables, le widget de chat renvoie une erreur 503 mais l'app fonctionne.
# COMPAGNON_WEBHOOK_URL=https://your-n8n-instance/webhook/xxx/chat
# COMPAGNON_WEBHOOK_USER=same-username-as-the-n8n-credential
# COMPAGNON_WEBHOOK_PASS=same-password-as-the-n8n-credential

# Optional — Resend for email verification + password reset.
# App runs fine without these (verification/reset URLs are logged to the
# server console instead of being emailed — useful in dev/CI).
# Get an API key at https://resend.com/ (free tier: 3k emails/month).
# RESEND_API_KEY=re_XXXXXXXX
# RESEND_FROM_EMAIL="Echo <noreply@yourdomain.com>"   # default: onboarding@resend.dev (works without domain verif)
# APP_URL=https://echo.yourdomain.com   # used to build verification/reset links — default http://localhost:3000

# Optional — gate POST/vote/comment APIs behind verified email.
# Set to "true" once existing users have been migrated to verified.
# REQUIRE_EMAIL_VERIFICATION=true

# Optional — Upstash Redis for per-IP rate limiting (login/signup/vote).
# App runs fine without these (limiter is no-op when env vars absent).
# Free tier at https://upstash.com/ → Redis → REST API.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXX...

# Optional — Sentry error monitoring. App runs fine without these (no-op).
# Get DSN from sentry.io/settings/[org]/projects/[proj]/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=echo
# SENTRY_AUTH_TOKEN=sntrys_...   # only needed for source map upload at build
